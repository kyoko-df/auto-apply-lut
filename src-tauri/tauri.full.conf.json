{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LUTlab",
  "identifier": "com.kyokodf.auto-apply-lut.full",
  "build": {
    "beforeBundleCommand": "node scripts/prepare-ffmpeg.mjs"
  },
  "bundle": {
    "resources": {
      "resources/bin/": "bin/",
      "resources/licenses/": "licenses/",
      "resources/ffmpeg-manifest.json": "ffmpeg-manifest.json",
      "resources/libraw-manifest.json": "libraw-manifest.json"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" }
    }
  }
}
