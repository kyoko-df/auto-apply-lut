{
  "name": "auto-apply-lut",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.mjs",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs --target aarch64-apple-darwin",
    "test:release": "node --test scripts/*.test.mjs",
    "release:mac:arm64": "pnpm fetch:ffmpeg && pnpm tauri:build:full:mac:arm64",
    "tauri:build:lite": "tauri build --config src-tauri/tauri.lite.conf.json",
    "tauri:build:full:win": "tauri build --target x86_64-pc-windows-msvc --config src-tauri/tauri.full.conf.json",
    "tauri:build:full:mac": "tauri build --config src-tauri/tauri.full.conf.json",
    "tauri:build:full:mac:arm64": "tauri build --target aarch64-apple-darwin --config src-tauri/tauri.full.conf.json",
    "tauri:build:full:mac:universal": "tauri build --target universal-apple-darwin --config src-tauri/tauri.full.conf.json",
    "benchmark:media": "node scripts/benchmark-media.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@types/node": "^24.3.0",
    "autoprefixer": "^10.4.21",
    "i18next": "^26.4.2",
    "lucide-react": "^0.542.0",
    "postcss": "^8.5.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.0.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.4"
  }
}
